# Copy to .env for local builds. On Cloudflare Pages, set these as
# environment variables (secrets encrypted) for the Production environment.

# Public site address, no trailing slash.
SITE_URL=https://newgeorgiapawn.com

# --- Google Sheet (owner edits) ---------------------------------------------
# File > Share > Publish to web > (whole document) > CSV. The published link
# looks like https://docs.google.com/spreadsheets/d/e/<PUB_ID>/pub?...
SHEET_PUB_ID=
# The gid= number of each tab (shown in the URL when the tab is open).
SHEET_GID_HOURS=
SHEET_GID_CLOSURES=
SHEET_GID_BANNER=
SHEET_GID_SETTINGS=

# --- Browser-side ----------------------------------------------------------------
# Turnstile site key. The default is Cloudflare's always-passes test key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cloudflare Web Analytics beacon token (leave empty to disable).
PUBLIC_CF_BEACON_TOKEN=

# --- Local development only ---------------------------------------------------------
# Use the sample closure and banner in fixtures/shop.json to preview them.
SHOP_FIXTURES=0
