---
import Stars from './Stars.astro';
import { business } from '../data/site';
import { shop } from '../lib/shop';

const rating = shop.rating;
const since = new Date(business.founded).getUTCFullYear();
---

<section class="trust section--band" aria-label="Why customers trust us">
  <div class="container items">
    {
      rating && (
        <div class="item rating">
          <span class="score">{rating.value.toFixed(1)}</span>
          <span>
            <Stars value={rating.value} />
            <span class="sub">
              {rating.count} reviews on{' '}
              {rating.url ? (
                <a href={rating.url} rel="noopener">
                  {rating.source}
                </a>
              ) : (
                rating.source
              )}
            </span>
          </span>
        </div>
      )
    }
    <div class="item">
      <strong>{business.licenseLine}</strong>
      <span class="sub"><span class="nowrap">FFL {business.ffl.number}</span></span>
    </div>
    <div class="item">
      <strong>Locally owned since {since}</strong>
      <span class="sub">In the New Georgia community, {business.address.county}</span>
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: var(--s-6);
  }
  .items {
    display: grid;
    gap: var(--s-5);
  }
  .item {
    display: grid;
    gap: 2px;
    font-size: var(--text-small);
    align-content: center;
  }
  .rating {
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: center;
  }
  .score {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
  }
  .sub {
    display: block;
    color: var(--muted);
  }
  @media (min-width: 768px) {
    .items {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-6);
    }
    .item + .item {
      border-left: var(--hairline);
      padding-left: var(--s-6);
    }
  }
</style>
