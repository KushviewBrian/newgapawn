---
/**
 * Facebook section. Meta's Page Plugin currently renders only the Page header
 * (its timeline comes back empty for every Page, as of Oct 2026), so this
 * shows that header, with the follower count and Follow button, above a
 * "feed coming soon" panel. The native post feed (Graph API import) replaces
 * the panel once the shop's Page is connected.
 *
 * The Facebook SDK only loads when the section nears the viewport. Without
 * JavaScript, or when a browser blocks Facebook, a plain link takes the
 * header's place.
 */
import Icon from './Icon.astro';
import { business } from '../data/site';

interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  headingId?: string;
}
const {
  eyebrow = 'Latest from the shop',
  heading = 'New in the case this week',
  text = 'New arrivals, deals, and closures go up on our Facebook page first. Follow us there so you see them as soon as they come in.',
  headingId = 'feed-h',
} = Astro.props;
---

<section class="section feed" aria-labelledby={headingId}>
  <div class="container split split--even split--center">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id={headingId}>{heading}</h2>
      <p class="lede">{text}</p>
      <ul class="checks small">
        <li>Guns are in-store pickup only. Call to check what's still available.</li>
        <li>Want something you see? Call and we'll tell you if it's still here.</li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--ink" href={`tel:${business.phoneE164}`} data-track="call" data-track-where="feed">
          <Icon name="phone" /> Call about an item
        </a>
      </div>
    </div>

    <div class="panel">
      <div class="fb-head" data-fb-frame>
        <div
          class="fb-page"
          data-href={business.links.facebook}
          data-tabs=""
          data-width=""
          data-height="70"
          data-small-header="true"
          data-adapt-container-width="true"
          data-hide-cover="false"
          data-show-facepile="false"
        >
          <blockquote cite={business.links.facebook} class="fb-xfbml-parse-ignore">
            <a class="head-link" href={business.links.facebook} rel="noopener">
              <Icon name="facebook" size={28} />
              <span>
                <strong>New Georgia Pawn Shop</strong>
                <span>on Facebook</span>
              </span>
            </a>
          </blockquote>
        </div>
      </div>

      <div class="soon">
        <span class="soon-icon" aria-hidden="true"><Icon name="camera" size={26} /></span>
        <p class="eyebrow">Feed coming soon</p>
        <p class="soon-title">Our latest posts will show up right here.</p>
        <p class="soon-text">
          Until then, follow us on Facebook for new arrivals, deals, and store closures as soon as we post them.
        </p>
        <a class="btn btn--brass" href={business.links.facebook} rel="noopener" data-track="facebook" data-track-where="feed">
          <Icon name="facebook" /> Follow us on Facebook
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /** Loads Facebook's JavaScript SDK once, when the section nears the viewport. */
  declare global {
    interface Window {
      FB?: { init(o: object): void; XFBML: { parse(el?: Element): void } };
      fbAsyncInit?: () => void;
    }
  }

  const SDK_VERSION = 'v26.0';
  let sdkRequested = false;

  function loadSdk() {
    if (sdkRequested) return;
    sdkRequested = true;
    if (!document.getElementById('fb-root')) {
      const root = document.createElement('div');
      root.id = 'fb-root';
      document.body.prepend(root);
    }
    window.fbAsyncInit = () => window.FB!.init({ xfbml: true, version: SDK_VERSION });
    const script = document.createElement('script');
    script.src = 'https://connect.facebook.net/en_US/sdk.js';
    script.async = true;
    script.defer = true;
    script.crossOrigin = 'anonymous';
    script.referrerPolicy = 'origin';
    document.body.append(script);
  }

  // Facebook defaults the header to 340 px; size it to the panel (plugin max 500).
  function sizeFor(frame: HTMLElement) {
    const page = frame.querySelector<HTMLElement>('.fb-page')!;
    page.dataset.width = String(Math.max(180, Math.min(500, Math.floor(frame.clientWidth))));
  }

  document.querySelectorAll<HTMLElement>('[data-fb-frame]').forEach((frame) => {
    // Pristine copy, so the header can be re-rendered at a new width.
    const template = frame.querySelector('.fb-page')!.cloneNode(true) as HTMLElement;

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        sizeFor(frame);
        loadSdk();

        // The plugin sizes itself once; re-render after a real width change (e.g. rotation).
        let last = frame.clientWidth;
        new ResizeObserver(() => {
          const w = frame.clientWidth;
          if (!window.FB || Math.abs(w - last) < 40 || (w >= 500 && last >= 500)) return;
          last = w;
          frame.querySelector('.fb-page')!.replaceWith(template.cloneNode(true));
          sizeFor(frame);
          window.FB.XFBML.parse(frame);
        }).observe(frame);
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(frame);
  });
</script>

<style>
  .copy {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .copy .btn-row {
    margin-top: var(--s-2);
  }
  .panel {
    width: 100%;
    max-width: 500px;
    margin-inline: auto;
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--card);
    overflow: hidden;
  }

  /* Facebook's Page header (followers, Follow button). Reserved height avoids layout shift. */
  .fb-head {
    min-height: 72px;
    border-bottom: var(--hairline);
    background: #fff;
  }
  .fb-head :global(.fb-page),
  .fb-head :global(.fb-page > span),
  .fb-head :global(iframe) {
    display: block;
    width: 100% !important;
    border: 0;
  }
  .fb-head :global(.fb_iframe_widget .fb-xfbml-parse-ignore) {
    display: none;
  }
  blockquote {
    margin: 0;
  }
  .head-link {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 72px;
    padding: var(--s-3) var(--s-4);
    color: var(--ink);
    text-decoration: none;
  }
  .head-link :global(svg) {
    color: #1877f2;
  }
  .head-link > span {
    display: grid;
    line-height: 1.3;
  }
  .head-link > span > span {
    font-size: var(--text-small);
    color: var(--muted);
  }

  .soon {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-7) var(--s-6);
    text-align: center;
    background:
      linear-gradient(var(--card), color-mix(in srgb, var(--card) 80%, transparent)),
      repeating-linear-gradient(135deg, var(--paper) 0 14px, var(--paper-2) 14px 28px);
  }
  .soon-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--s-1);
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--brass-deep);
  }
  .soon .eyebrow {
    margin: 0;
  }
  .soon-title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    max-width: 18ch;
  }
  .soon-text {
    max-width: 36ch;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .soon .btn {
    margin-top: var(--s-2);
  }
</style>
