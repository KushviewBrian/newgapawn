---
/**
 * The shop's public Facebook Page via Meta's Page Plugin, rendered by the
 * Facebook JavaScript SDK. The SDK only loads when the section nears the
 * viewport, so it costs nothing on first load. Without JavaScript, or when a
 * browser blocks Facebook, visitors get a link to the Page instead.
 */
import Icon from './Icon.astro';
import { business } from '../data/site';

interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  headingId?: string;
}
const {
  eyebrow = 'Latest from the shop',
  heading = 'New in the case this week',
  text = 'New arrivals, deals, and closures go up on our Facebook page first. You can scroll through them here without a Facebook account.',
  headingId = 'feed-h',
} = Astro.props;
---

<section class="section feed" aria-labelledby={headingId}>
  <div class="container split split--even">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id={headingId}>{heading}</h2>
      <p class="lede">{text}</p>
      <ul class="checks small">
        <li>Guns are in-store pickup only. Call to check what's still available.</li>
        <li>Want something you see? Call and we'll tell you if it's still here.</li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--outline" href={business.links.facebook} rel="noopener" data-track="facebook">
          <Icon name="facebook" /> Follow us on Facebook
        </a>
        <a class="btn btn--ink" href={`tel:${business.phoneE164}`} data-track="call" data-track-where="feed">
          <Icon name="phone" /> Call about an item
        </a>
      </div>
    </div>

    <div class="frame" data-fb-frame>
      <div
        class="fb-page"
        data-href={business.links.facebook}
        data-tabs="timeline"
        data-small-header="true"
        data-adapt-container-width="true"
        data-hide-cover="false"
        data-show-facepile="false"
      >
        <blockquote cite={business.links.facebook} class="fb-xfbml-parse-ignore">
          <a class="fallback" href={business.links.facebook} rel="noopener">
            <Icon name="facebook" size={32} />
            <strong>See our latest posts on Facebook</strong>
            <span>New arrivals, deals, and store closures</span>
          </a>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Loads Facebook's JavaScript SDK once, when a feed nears the viewport, and
   * lets it render every .fb-page on the page (the same approach that works on
   * our other sites; the bare plugin iframe can come back with an empty timeline).
   */
  declare global {
    interface Window {
      FB?: { init(o: object): void; XFBML: { parse(el?: Element): void } };
      fbAsyncInit?: () => void;
    }
  }

  const SDK_VERSION = 'v24.0';
  let sdkRequested = false;

  function sizeFor(frame: HTMLElement) {
    const page = frame.querySelector<HTMLElement>('.fb-page')!;
    page.dataset.width = String(Math.max(180, Math.min(500, Math.floor(frame.clientWidth))));
    page.dataset.height = String(Math.max(70, Math.floor(frame.clientHeight)));
  }

  function loadSdk() {
    if (sdkRequested) return;
    sdkRequested = true;
    if (!document.getElementById('fb-root')) {
      const root = document.createElement('div');
      root.id = 'fb-root';
      document.body.prepend(root);
    }
    window.fbAsyncInit = () => window.FB!.init({ xfbml: true, version: SDK_VERSION });
    const script = document.createElement('script');
    script.src = 'https://connect.facebook.net/en_US/sdk.js';
    script.async = true;
    script.defer = true;
    script.crossOrigin = 'anonymous';
    document.body.append(script);
  }

  document.querySelectorAll<HTMLElement>('[data-fb-frame]').forEach((frame) => {
    // Pristine copy, so the plugin can be re-rendered at a new width.
    const template = frame.querySelector('.fb-page')!.cloneNode(true) as HTMLElement;

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        sizeFor(frame);
        loadSdk();

        // The plugin sizes itself once; re-render after a real width change (e.g. rotation).
        let last = frame.clientWidth;
        new ResizeObserver(() => {
          const w = frame.clientWidth;
          if (!window.FB || Math.abs(w - last) < 40 || (w >= 500 && last >= 500)) return;
          last = w;
          frame.querySelector('.fb-page')!.replaceWith(template.cloneNode(true));
          sizeFor(frame);
          window.FB.XFBML.parse(frame);
        }).observe(frame);
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(frame);
  });
</script>

<style>
  .copy {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .copy .btn-row {
    margin-top: var(--s-2);
  }
  @media (min-width: 1024px) {
    .copy {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
    }
  }
  .frame {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 640px;
    margin-inline: auto;
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--card);
    overflow: hidden;
  }
  .frame :global(.fb-page),
  .frame :global(.fb-page > span),
  .frame :global(iframe) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    border: 0;
  }
  .frame :global(iframe) {
    background: #fff;
  }
  /* Once the SDK has rendered the plugin, hide the link fallback. */
  .frame :global(.fb_iframe_widget .fb-xfbml-parse-ignore) {
    display: none;
  }
  blockquote {
    margin: 0;
  }
  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-2);
    padding: var(--s-6);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    background: repeating-linear-gradient(135deg, var(--paper) 0 14px, var(--paper-2) 14px 28px);
  }
  .fallback :global(svg) {
    color: #1877f2;
  }
  .fallback span {
    color: var(--muted);
    font-size: var(--text-small);
  }
  @media (max-width: 1023px) {
    .frame {
      height: 560px;
    }
  }
</style>
