---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { business, nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <Wordmark />

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--brass call" href={`tel:${business.phoneE164}`} data-track="call" data-track-where="header">
      <Icon name="phone" />
      <span>{business.phone}</span>
    </a>

    <button class="menu-btn" type="button" popovertarget="site-menu" aria-label="Open menu">
      <Icon name="menu" size={26} />
    </button>
  </div>

  <div id="site-menu" class="sheet" popover>
    <div class="sheet-top container">
      <Wordmark />
      <button class="menu-btn" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Close menu">
        <Icon name="close" size={26} />
      </button>
    </div>
    <nav class="container" aria-label="Main">
      <ul class="sheet-links">
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/get-an-offer/">Get an Offer</a></li>
      </ul>
      <div class="sheet-actions">
        <a class="btn btn--brass btn--block" href={`tel:${business.phoneE164}`} data-track="call" data-track-where="menu">
          <Icon name="phone" /> Call {business.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom: var(--hairline);
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      backdrop-filter: saturate(1.2) blur(8px);
    }
  }
  @media (min-width: 1024px) {
    .site-header {
      position: sticky;
      top: 0;
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: var(--header-h);
  }
  .nav-desktop {
    display: none;
    margin-left: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    padding: 0;
  }
  .nav-desktop a {
    display: block;
    padding: var(--s-2) var(--s-3);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius);
    position: relative;
  }
  .nav-desktop a:hover {
    background: var(--paper-2);
  }
  .nav-desktop a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 2px;
    height: 2px;
    background: var(--brass);
  }
  .call {
    display: none;
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-left: auto;
    background: var(--card);
    border: var(--hairline);
    border-radius: var(--radius-lg);
    color: var(--ink);
  }
  @media (min-width: 1024px) {
    .nav-desktop,
    .call {
      display: flex;
    }
    .bar > .menu-btn {
      display: none;
    }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .call span {
      display: none;
    }
    .call {
      padding-inline: var(--s-4);
    }
  }

  /* Full-screen phone menu, using the native popover (works without JavaScript). */
  .sheet {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 0 var(--s-7);
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
  }
  .sheet::backdrop {
    background: rgb(28 28 26 / 0.4);
  }
  .sheet-top {
    display: flex;
    align-items: center;
    min-height: var(--header-h);
    border-bottom: var(--hairline);
  }
  .sheet-links {
    list-style: none;
    padding: var(--s-4) 0;
  }
  .sheet-links a {
    display: block;
    padding: var(--s-3) 0;
    border-bottom: var(--hairline);
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .sheet-links a[aria-current='page'] {
    color: var(--brass-deep);
  }
  .sheet-actions {
    padding-top: var(--s-4);
  }
</style>
