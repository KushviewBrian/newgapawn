---
import LogoMark from './LogoMark.astro';

interface Props {
  tone?: 'ink' | 'light';
}
const { tone = 'ink' } = Astro.props;
---

<a class:list={['wordmark', tone]} href="/">
  <LogoMark size={42} />
  <span class="text">
    <span class="name">New Georgia Pawn</span>{' '}
    <span class="place">Dallas, Georgia</span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .wordmark.light {
    color: var(--on-dark);
  }
  .text {
    display: grid;
    line-height: 1;
  }
  .name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }
  .place {
    margin-top: 4px;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .light .place {
    color: var(--on-dark-muted);
  }
</style>
