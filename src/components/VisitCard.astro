---
/** Compact "visit the shop" card that fills inner-page heroes until photos arrive (desktop only). */
import Icon from './Icon.astro';
import OpenBadge from './OpenBadge.astro';
import { business, mapsLinks } from '../data/site';
---

<aside class="card visit-card" aria-label="Visit the shop">
  <span class="eyebrow">Visit the shop</span>
  <OpenBadge />
  <p class="addr">
    {business.address.street}<br />
    {`${business.address.city}, ${business.address.region} ${business.address.postalCode}`}
  </p>
  <a class="btn btn--brass btn--block" href={`tel:${business.phoneE164}`} data-track="call" data-track-where="hero-card">
    <Icon name="phone" />
    {business.phone}
  </a>
  <div class="links">
    <a class="link-arrow" href={mapsLinks.google} data-directions={mapsLinks.apple} data-track="directions" data-track-where="hero-card" rel="noopener">Directions</a>
    <a class="link-arrow" href="/visit/#hours">All store hours</a>
  </div>
</aside>

<style>
  .visit-card {
    display: none;
  }
  @media (min-width: 1024px) {
    .visit-card {
      display: grid;
      gap: var(--s-4);
      max-width: 360px;
      justify-self: end;
      padding: var(--s-6);
      border-top: 3px solid var(--brass);
    }
  }
  .addr {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }
</style>
