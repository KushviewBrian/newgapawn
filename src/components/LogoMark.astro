---
/**
 * The shop's mark: the classic pawnbroker's three balls, hung from an arched
 * hanger with the site's brass diamond as the hook. The hanger follows the
 * text color (ink on light backgrounds, cream on dark); the balls stay brass.
 * Master files for print and social live in public/brand/.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<svg class:list={['logo-mark', className]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
    <path d="M32 9.5V41"></path>
    <path d="M13 33.5C13 21 21.5 14.5 32 14.5S51 21 51 33.5"></path>
  </g>
  <path class="brass" d="M32 2.5 36 6.5 32 10.5 28 6.5Z"></path>
  <g class="brass">
    <circle cx="13" cy="41.5" r="8.5"></circle>
    <circle cx="51" cy="41.5" r="8.5"></circle>
    <circle cx="32" cy="50.5" r="8.5"></circle>
  </g>
  <g class="shine">
    <circle cx="10" cy="38.5" r="2"></circle>
    <circle cx="48" cy="38.5" r="2"></circle>
    <circle cx="29" cy="47.5" r="2"></circle>
  </g>
</svg>

<style>
  .logo-mark {
    flex: none;
  }
  .brass {
    fill: var(--brass);
  }
  .shine {
    fill: var(--brass-light);
    opacity: 0.85;
  }
</style>
