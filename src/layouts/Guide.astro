---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import OfferBand from '../components/OfferBand.astro';
import { guides, type Guide } from '../data/guides';
import { business } from '../data/site';
import { articleSchema } from '../lib/schema';

interface Props {
  slug: Guide['slug'];
}
const guide = guides.find((g) => g.slug === Astro.props.slug)!;
const path = `/guides/${guide.slug}/`;
const crumbs = [
  { name: 'Guides', path: '/guides/' },
  { name: guide.title, path },
];
const others = guides.filter((g) => g.slug !== guide.slug);
const updated = new Date(`${guide.updated}T12:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={guide.title}
  description={guide.description}
  og={guide.slug}
  breadcrumbs={crumbs}
  schema={[articleSchema(Astro.site!, { title: guide.title, description: guide.description, path, updated: guide.updated })]}
>
  <PageHero eyebrow="Guide" title={guide.title} lede={guide.description} crumbs={crumbs}>
    <p class="small muted">Updated {updated} · {guide.readTime}</p>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <article class="prose">
        <slot />
        <p class="disclaimer small muted">
          This guide is general information, not legal advice. Rules change; ask us at the counter or check the official source if
          you're unsure.
        </p>
      </article>

      <aside class="side" aria-label="Related">
        <div class="card stack">
          <span class="eyebrow">Ready when you are</span>
          <p class="h3">{guide.service.label}</p>
          <a class="link-arrow" href={guide.service.href}>See how we do it</a>
          <a class="btn btn--brass btn--block" href={`tel:${business.phoneE164}`} data-track="call" data-track-where="guide">
            <Icon name="phone" /> {business.phone}
          </a>
        </div>
        <div class="card stack">
          <span class="eyebrow">More guides</span>
          <ul class="more">
            {
              others.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}/`}>{g.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <OfferBand />
</Base>

<style>
  .layout {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--s-8);
    }
    .side {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
      align-self: start;
    }
  }
  .side {
    display: grid;
    gap: var(--s-5);
  }
  .more {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .more a {
    font-weight: 600;
  }
  .disclaimer {
    margin-top: var(--s-7) !important;
    padding-top: var(--s-4);
    border-top: var(--hairline);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px var(--s-3);
    border-bottom: var(--hairline);
    text-align: left;
  }
  .prose :global(thead th) {
    border-bottom: 2px solid var(--ink);
    font-weight: 600;
  }
</style>
